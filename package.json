{
  "name": "malstrom-engine",
  "version": "0.1.0",
  "description": "Malstrom Engine launcher and game creation tools",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.malstrom.engine",
    "productName": "Malstrom Engine",
    "directories": { "output": "release" },
    "files": ["src/**/*", "package.json"],
    "win": {
      "target": ["nsis"],
      "artifactName": "Malstrom-Engine-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}